{
  "name": "alisha-cetak",
  "main": ".solid-vue/worker-entry.mjs",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alisha-cetak-db",
      "database_id": "ISI_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}